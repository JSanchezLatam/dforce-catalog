# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets (NFR-4: IFX_TOKEN etc. must stay server-only)
.env
.env*.local
# scripts/standalone.sh backs .env up before rewriting DATABASE_URL — the copy
# carries the same secrets and must never be committed either.
.env.bak-*

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea

# catalog visual gate output (scripts/preview-catalog.ts)
/preview-out
