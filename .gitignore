# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets (NFR-4: IFX_TOKEN etc. must stay server-only)
.env
.env*.local
# scripts/standalone.sh backs .env up before rewriting DATABASE_URL — the copy
# carries the same secrets and must never be committed either.
.env.bak-*

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea

# catalog visual gate output (scripts/preview-catalog.ts)
/preview-out

# Skill registry fingerprint cache — the gentle-ai UserPromptSubmit hook
# rewrites it on EVERY prompt, so tracking it left the working tree
# permanently dirty and dragged the file into unrelated feature commits.
# .atl/skill-registry.md is the real artifact and stays tracked.
.atl/.skill-registry.cache.json

# CodeGraph index — local to each machine (SQLite db, daemon pid, socket, logs).
# Ignore the whole directory: .codegraph/.gitignore could not exclude itself,
# so it showed up as untracked forever.
/.codegraph/
# Local AI runtime state
.atl/
