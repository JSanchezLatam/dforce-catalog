# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# Postgres connection string shared by Drizzle, Drizzle Kit, and pg-boss.
# 5433 is the host port docker-compose.yml publishes for the `db` service —
# NOT 5432, which a locally installed Postgres usually already occupies.
DATABASE_URL=postgres://dforce:dforce@localhost:5433/dforce_catalog

# Interfuerza API token. Server-only — must NEVER be logged, returned in
# HTTP responses, or committed to source (NFR-4). Not required until
# inventory-sync (Phase 2) is implemented.
IFX_TOKEN=your-interfuerza-api-token

# Interfuerza API base URL. Not required until inventory-sync (Phase 2).
IFX_BASE_URL=https://app.interfuerza.com/api/v4/

# Postgres credentials used by docker-compose.yml to boot the local Postgres
# container. Keep in sync with DATABASE_URL above.
POSTGRES_USER=dforce
POSTGRES_PASSWORD=dforce
POSTGRES_DB=dforce_catalog

# Cloudflare R2 (S3-compatible) — PDFs are stored here only, never on local
# disk (NFR-6). Not required until catalog-storage (Phase 7) runs a real
# generation. Server-only, same secrecy bar as IFX_TOKEN.
R2_ENDPOINT=https://083fa1962b530b82e41e182474de132b.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=dforce-catalog-pdfs
# Optional — a custom public domain for display purposes only. Downloads
# always proxy through /api/catalogs/[id]/file, never this URL directly.
R2_PUBLIC_URL=

# Reminders (customers/service-orders module) — all optional. Without
# these, reminders are still scheduled but record status=failed/skipped
# with a reason; nothing crashes at boot or at send time.
RESEND_API_KEY=
RESEND_FROM=
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_TEMPLATE_APPOINTMENT=
KAPSO_TEMPLATE_SERVICE_DUE=