# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# Postgres connection string shared by Drizzle, Drizzle Kit, and pg-boss.
DATABASE_URL=postgres://dforce:dforce@localhost:5432/dforce_catalog

# Interfuerza API token. Server-only — must NEVER be logged, returned in
# HTTP responses, or committed to source (NFR-4). Not required until
# inventory-sync (Phase 2) is implemented.
IFX_TOKEN=

# Postgres credentials used by docker-compose.yml to boot the local Postgres
# container. Keep in sync with DATABASE_URL above.
POSTGRES_USER=dforce
POSTGRES_PASSWORD=dforce
POSTGRES_DB=dforce_catalog
